# Copy to .env in the repository root; keep .env private and untracked.
# Run Compose from that directory, or supply --env-file /path/to/.env.
# single has no login; use multi with provisioned accounts for shared access.
AUTH_MODE=single
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
ASCEND_PUBLIC_URL=
VAPID_PRIVATE_KEY=/data/vapid.pem
VAPID_SUBJECT=
# Host-code execution remains disabled unless deliberately enabled.
ASCEND_ALLOW_CODE=0
PUSH_ALLOWED_HOSTS=
