# Private runner host configuration. Use chmod 600 for the real file.
# Generate a random key with: python3 -c 'import secrets; print(secrets.token_hex(32))'
ASCEND_RUNNER_KEY=
ASCEND_RUNNER_HOME=/var/lib/ascend-runner
ASCEND_RUNNER_MAX_ACTIVE=2
ASCEND_RUNNER_RESERVE_GIB=10
ASCEND_RUNNER_RECIPES=linux-audit-discovery,vampi-ownership,bgp-export-policy,wrongsecrets-basics,bgp-single-session,bgp-session-protection,bgp-prefix-filter
